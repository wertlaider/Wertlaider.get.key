local c2 = Instance.new("UICorner"); c2.CornerRadius = UDim.new(0, 8); c2.Parent = box
local pad = Instance.new("UIPadding")
pad.PaddingLeft = UDim.new(0, 12); pad.PaddingRight = UDim.new(0, 12); pad.Parent = box

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(1, -36, 0, 44)
btn.Position = UDim2.new(0, 18, 0, 142)
btn.BackgroundColor3 = Color3.fromRGB(80, 100, 220)
btn.Text = "Проверить"
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 15
btn.BorderSizePixel = 0
btn.Parent = main
local c3 = Instance.new("UICorner"); c3.CornerRadius = UDim.new(0, 8); c3.Parent = btn

local getBtn = Instance.new("TextButton")
getBtn.Size = UDim2.new(1, -36, 0, 36)
getBtn.Position = UDim2.new(0, 18, 0, 196)
getBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 44)
getBtn.Text = "Получить ключ в боте"
getBtn.TextColor3 = Color3.fromRGB(200, 200, 215)
getBtn.Font = Enum.Font.GothamMedium
getBtn.TextSize = 14
getBtn.BorderSizePixel = 0
getBtn.Parent = main
local c4 = Instance.new("UICorner"); c4.CornerRadius = UDim.new(0, 8); c4.Parent = getBtn
getBtn.MouseButton1Click:Connect(function()
    pcall(function()
        local sc = setclipboard or toclipboard
        if sc then sc(BOT_URL) end
    end)
    pcall(function() game:GetService("GuiService"):OpenBrowserWindow(BOT_URL) end)
end)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -36, 0, 30)
status.Position = UDim2.new(0, 18, 0, 240)
status.BackgroundTransparency = 1
status.Text = "Вставь ключ и нажми «Проверить»"
status.TextColor3 = Color3.fromRGB(150, 150, 165)
status.Font = Enum.Font.Gotham
status.TextSize = 13
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = main

-- === Logic ===
local busy = false

local function setStatus(t, col)
    status.Text = t
    status.TextColor3 = col or Color3.fromRGB(150, 150, 165)
end

local function doCheck()
    if busy then return end
    busy = true

    local key = box.Text:gsub("%s+", "")
    if #key < 4 then
        setStatus("Введи ключ", Color3.fromRGB(220, 100, 100))
        busy = false
        return
    end
    box.Text = key
    setStatus("Проверяю...", Color3.fromRGB(150, 150, 165))
    btn.Text = "..."

    task.spawn(function()
        local url = string.format(
            "%s/body?key=%s&deviceId=%s",
            API_URL,
            HttpService:UrlEncode(key),
            HttpService:UrlEncode(deviceId())
        )
        local ok, body, code = request(url)

        busy = false
        btn.Text = "Проверить"

        if not ok then
            setStatus("✗ " .. tostring(body or code or "network"), Color3.fromRGB(220, 100, 100))
            return
        end
        if #body < 100 then
            setStatus("✗ " .. body, Color3.fromRGB(220, 100, 100))
            return
        end

        setStatus("✓ Запускаю...", Color3.fromRGB(120, 220, 140))
        task.wait(0.3)
        gui:Destroy()

        local fn, err = loadstring(body)
        if not fn then
            warn("[Wertlaider] loadstring:", err)
            return
        end
        local okRun, errRun = pcall(fn)
        if not okRun then
            warn("[Wertlaider] run:", errRun)
        end
    end)
end

btn.MouseButton1Click:Connect(doCheck)
box.FocusLost:Connect(function(enter) if enter then doCheck() end end)

return gui
