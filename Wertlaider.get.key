-- language: Luau, file: loader.lua, runtime: Arceus
-- Публичный лоадер. Тянет тело чита через воркер после проверки ключа.

local API_URL = "https://wertlaider-api.kirillpanoa777.workers.dev"
local BOT_URL = "https://t.me/Wertlaider_key_bot"

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local function request(url)
    local ok, res = pcall(function()
        return request({ Url = url, Method = "GET", Headers = { ["Accept"] = "*/*" } })
    end)
    if not ok then return false, nil, "network" end
    local body = res.Body or res.body or ""
    local code = res.StatusCode or res.Status or 0
    return code >= 200 and code < 300, body, code
end

local _deviceId = nil
local function deviceId()
    if _deviceId then return _deviceId end
    local ok, id = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and typeof(id) == "string" and #id > 0 then
        _deviceId = id
    else
        _deviceId = tostring(game.PlaceId) .. "-" .. tostring(game.JobId) .. "-" .. tostring(math.floor(tick()))
    end
    return _deviceId
end

-- === UI ===
local parent = Players.LocalPlayer:WaitForChild("PlayerGui")
if parent:FindFirstChild("WertlaiderLoader") then parent.WertlaiderLoader:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "WertlaiderLoader"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = parent

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 420, 0, 280)
main.Position = UDim2.new(0.5, -210, 0.5, -140)
main.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
main.BorderSizePixel = 0
main.Active = true
main.Draggable = true
main.Parent = gui
local c1 = Instance.new("UICorner"); c1.CornerRadius = UDim.new(0, 12); c1.Parent = main
local s1 = Instance.new("UIStroke"); s1.Color = Color3.fromRGB(60, 60, 70); s1.Parent = main

