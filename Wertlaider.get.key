local c2 = Instance.new("UICorner"); c2.CornerRadius = UDim.new(0, 8); c2.Parent = box
local pad = Instance.new("UIPadding")
pad.PaddingLeft = UDim.new(0, 12); pad.PaddingRight = UDim.new(0, 12); pad.Parent = box

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(1, -36, 0, 44)
btn.Position = UDim2.new(0, 18, 0, 142)
