main.Active = true
main.Draggable = true
main.Parent = gui
local c1 = Instance.new("UICorner"); c1.CornerRadius = UDim.new(0, 12); c1.Parent = main
local s1 = Instance.new("UIStroke"); s1.Color = Color3.fromRGB(60, 60, 70); s1.Parent = main

