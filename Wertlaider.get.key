-- language: Luau, file: Wertlaider.get.key, runtime: Arceus
-- Лоадер с сохранением ключа и поддержкой генератора.

local API_URL = "https://wertlaider-api.kirillpanoa777.workers.dev"
local BOT_URL = "https://t.me/Wertlaider_key_bot"
local STORAGE_FILE = "Wertlaider_key.txt"

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

-- ============ HTTP ============
local function httpGet(url)
    local candidates = {
        rawget(getfenv(), "request"),
        rawget(getfenv(), "http_request"),
        rawget(getfenv(), "httprequest"),
        rawget(getfenv(), "HttpGet"),
        (syn and syn.request) or nil,
        (http and http.request) or nil,
    }
    for _, fn in ipairs(candidates) do
        if typeof(fn) == "function" then
            local ok, res = pcall(fn, { Url = url, Method = "GET" })
            if ok and typeof(res) == "table" then
                local code = res.StatusCode or res.Status or res.status or 200
                local body = res.Body or res.body or res.Data or ""
                return code >= 200 and code < 300, body
            end
        end
    end
    local ok, res = pcall(function() return game:HttpGet(url, true) end)
    if ok and typeof(res) == "string" then return true, res end
    return false, "no_http_function"
end

-- ============ deviceId ============
local _deviceId = nil
local function deviceId()
    if _deviceId then return _deviceId end
    local ok, id = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and typeof(id) == "string" and #id > 0 then
        _deviceId = id
    else
        _deviceId = tostring(game.PlaceId) .. "-" .. tostring(game.JobId) .. "-" .. tostring(math.floor(tick()))
    end
    return _deviceId
end

-- ============ STORAGE ============
local function loadStoredKey()
    local ok, data = pcall(function() return readfile(STORAGE_FILE) end)
    if ok and typeof(data) == "string" and #data > 4 then return data end
    return nil
end

local function saveKey(k)
    pcall(function() writefile(STORAGE_FILE, k) end)
end

local function clearStoredKey()
    pcall(function() delfile(STORAGE_FILE) end)
end

-- ============ UI ============
