local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -36, 0, 30)
status.Position = UDim2.new(0, 18, 0, 240)
status.BackgroundTransparency = 1
status.Text = "Вставь ключ и нажми «Проверить»"
status.TextColor3 = Color3.fromRGB(150, 150, 165)
status.Font = Enum.Font.Gotham
status.TextSize = 13
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = main

-- ============ LOGIC ============
local busy = false

local function setStatus(t, col)
    status.Text = t
    status.TextColor3 = col or Color3.fromRGB(150, 150, 165)
end

local function doCheck()
    if busy then return end
    busy = true

    local key = box.Text:gsub("%s+", "")
    if #key < 4 then
        setStatus("Введи ключ", Color3.fromRGB(220, 100, 100))
        busy = false
        return
    end
    box.Text = key
    setStatus("Проверяю...", Color3.fromRGB(150, 150, 165))
    btn.Text = "..."

    task.spawn(function()
        -- 1) /check
        local checkUrl = string.format(
            "%s/check?key=%s&deviceId=%s",
            API_URL,
            HttpService:UrlEncode(key),
            HttpService:UrlEncode(deviceId())
        )
        local okC, checkBody = httpGet(checkUrl)
        if not okC or typeof(checkBody) ~= "string" then
            busy = false
            btn.Text = "Проверить"
            setStatus("✗ нет связи с сервером", Color3.fromRGB(220, 100, 100))
            return
        end

        local okJ, checkData = pcall(function() return HttpService:JSONDecode(checkBody) end)
        if not okJ or typeof(checkData) ~= "table" then
            busy = false
            btn.Text = "Проверить"
            setStatus("✗ сервер вернул мусор", Color3.fromRGB(220, 100, 100))
            return
        end

        -- генератор: сервер выдал новый вечный ключ
        if checkData.error == "generated" and checkData.generatedKey then
            busy = false
            btn.Text = "Проверить"
            box.Text = checkData.generatedKey
            saveKey(checkData.generatedKey)
            pcall(function()
                local sc = setclipboard or toclipboard
                if sc then sc(checkData.generatedKey) end
            end)
            setStatus("✓ Твой ключ сохранён и скопирован", Color3.fromRGB(120, 220, 140))
            return
        end

        if checkData.valid ~= true then
            busy = false
            btn.Text = "Проверить"
            local errMap = {
                invalid_key = "Ключ не найден",
                expired_key = "Ключ истёк",
                device_mismatch = "Ключ привязан к другому устройству",
                revoked_key = "Ключ отозван",
            }
            setStatus("✗ " .. (errMap[checkData.error] or tostring(checkData.error)), Color3.fromRGB(220, 100, 100))
            if checkData.error == "invalid_key" or checkData.error == "revoked_key" then
                clearStoredKey()
            end
            return
        end

        -- 2) /body
        local bodyUrl = string.format(
            "%s/body?key=%s&deviceId=%s",
            API_URL,
            HttpService:UrlEncode(key),
            HttpService:UrlEncode(deviceId())
        )
        local okB, body = httpGet(bodyUrl)

        busy = false
        btn.Text = "Проверить"

        if not okB or typeof(body) ~= "string" or #body < 100 then
            setStatus("✗ " .. tostring(body or "network"), Color3.fromRGB(220, 100, 100))
            return
        end

        saveKey(key)
        setStatus("✓ Запускаю...", Color3.fromRGB(120, 220, 140))
        task.wait(0.3)
        gui:Destroy()

        local fn, err = loadstring(body)
        if not fn then warn("[Wertlaider] loadstring:", err); return end
        local okRun, errRun = pcall(fn)
        if not okRun then warn("[Wertlaider] run:", errRun) end
    end)
end

btn.MouseButton1Click:Connect(doCheck)
box.FocusLost:Connect(function(enter) if enter then doCheck() end end)

-- авто-проверка при запуске, если ключ сохранён
local storedKey = loadStoredKey()
if storedKey then
    box.Text = storedKey
    task.defer(doCheck)
else
    setStatus("Вставь ключ и нажми «Проверить»", Color3.fromRGB(150, 150, 165))
end

return gui