getBtn.Parent = main
local c4 = Instance.new("UICorner"); c4.CornerRadius = UDim.new(0, 8); c4.Parent = getBtn
getBtn.MouseButton1Click:Connect(function()
    pcall(function()
        local sc = setclipboard or toclipboard
        if sc then sc(BOT_URL) end
    end)
    pcall(function() game:GetService("GuiService"):OpenBrowserWindow(BOT_URL) end)
end)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -36, 0, 30)
status.Position = UDim2.new(0, 18, 0, 240)
status.BackgroundTransparency = 1
status.Text = "Вставь ключ и нажми «Проверить»"
status.TextColor3 = Color3.fromRGB(150, 150, 165)
status.Font = Enum.Font.Gotham
status.TextSize = 13
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = main

-- ============ LOGIC ============
local busy = false

local function setStatus(t, col)
    status.Text = t
    status.TextColor3 = col or Color3.fromRGB(150, 150, 165)
end

local ERROR_TEXT = {
    ["invalid key"] = "Ключ не найден",
    ["expired"] = "Ключ истёк",
    ["device mismatch"] = "Ключ привязан к другому устройству",
    ["revoked"] = "Ключ отозван",
    ["missing key or deviceId"] = "Пустой ключ",
    ["github not configured"] = "Воркер настроен неполно",
}

local function doCheck()
    if busy then return end
    busy = true

    local key = box.Text:gsub("%s+", "")
    if #key < 4 then
        setStatus("Введи ключ", Color3.fromRGB(220, 100, 100))
        busy = false
        return
    end
    box.Text = key
    setStatus("Проверяю...", Color3.fromRGB(150, 150, 165))
    btn.Text = "..."

    task.spawn(function()
        local bodyUrl = string.format(
            "%s/body?key=%s&deviceId=%s",
            API_URL,
            HttpService:UrlEncode(key),
            HttpService:UrlEncode(deviceId())
        )
        local code, body = httpGet(bodyUrl)

        if code == 400 and typeof(body) == "string" and body:find("gen_key_use_check") then
            local checkUrl = string.format(
                "%s/check?key=%s&deviceId=%s",
                API_URL,
                HttpService:UrlEncode(key),
                HttpService:UrlEncode(deviceId())
            )
            local _, body2 = httpGet(checkUrl)
            local okJ, data = pcall(function() return HttpService:JSONDecode(body2) end)
            busy = false
            btn.Text = "Проверить"
            if okJ and typeof(data) == "table" and data.error == "generated" and data.generatedKey then
                box.Text = data.generatedKey
                saveKey(data.generatedKey)
                pcall(function()
                    local sc = setclipboard or toclipboard
                    if sc then sc(data.generatedKey) end
                end)
                setStatus("✓ Твой ключ сохранён и скопирован", Color3.fromRGB(120, 220, 140))
            else
                setStatus("✗ Генератор не сработал", Color3.fromRGB(220, 100, 100))
            end
            return
        end

        busy = false
        btn.Text = "Проверить"

        if code == 200 and typeof(body) == "string" and #body > 100 then
            saveKey(key)
            setStatus("✓ Запускаю...", Color3.fromRGB(120, 220, 140))
            task.wait(0.3)
            gui:Destroy()
            local fn, err = loadstring(body)
            if not fn then warn("[Wertlaider] loadstring:", err); return end
            local okRun, errRun = pcall(fn)
            if not okRun then warn("[Wertlaider] run:", errRun) end
            return
        end

        local msg = typeof(body) == "string" and body or "network"
        if code == 0 then msg = "нет связи" end
        local pretty = ERROR_TEXT[msg] or msg
        setStatus("✗ " .. pretty, Color3.fromRGB(220, 100, 100))
        if msg == "invalid key" or msg == "revoked" then clearStoredKey() end
    end)
end

btn.MouseButton1Click:Connect(doCheck)
box.FocusLost:Connect(function(enter) if enter then doCheck() end end)

local storedKey = loadStoredKey()
if storedKey then
    box.Text = storedKey
    task.defer(doCheck)
else
    setStatus("Вставь ключ и нажми «Проверить»", Color3.fromRGB(150, 150, 165))
end

return gui