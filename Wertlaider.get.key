-- language: Luau, file: Wertlaider.get.key, runtime: Arceus
-- Один запрос /body. Сохранение ключа. Генератор.

local API_URL = "https://wertlaider-api.kirillpanoa777.workers.dev"
local BOT_URL = "https://t.me/Wertlaider_key_bot"
local STORAGE_FILE = "Wertlaider_key.txt"

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

-- ============ HTTP ============
local function httpGet(url)
    local ok, res = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and typeof(res) == "string" and #res > 0 then
        if res == "invalid key" then return 401, res end
        if res == "expired" then return 401, res end
        if res == "device mismatch" then return 403, res end
        if res == "revoked" then return 401, res end
        if res == "missing key or deviceId" then return 400, res end
        if res == "github not configured" then return 500, res end
        if res:find("gen_key_use_check") then return 400, res end
        if res:find("body fetch failed") then return 502, res end
        return 200, res
    end
    return 0, "no_http"
end

-- ============ deviceId ============
local _deviceId = nil
local function deviceId()
    if _deviceId then return _deviceId end
    local ok, id = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and typeof(id) == "string" and #id > 0 then
        _deviceId = id
    else
        _deviceId = tostring(game.PlaceId) .. "-" .. tostring(game.JobId) .. "-" .. tostring(math.floor(tick()))
    end
    return _deviceId
end

-- ============ STORAGE ============
local function loadStoredKey()
    local ok, data = pcall(function() return readfile(STORAGE_FILE) end)
    if ok and typeof(data) == "string" and #data > 4 then return data end
    return nil
end

local function saveKey(k)
    pcall(function() writefile(STORAGE_FILE, k) end)
end

local function clearStoredKey()
    pcall(function() delfile(STORAGE_FILE) end)
end

-- ============ UI ============
local parent = Players.LocalPlayer:WaitForChild("PlayerGui")
if parent:FindFirstChild("WertlaiderLoader") then
    parent.WertlaiderLoader:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "WertlaiderLoader"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = parent

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 420, 0, 280)
main.Position = UDim2.new(0.5, -210, 0.5, -140)
